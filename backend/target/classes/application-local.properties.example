# Copie este arquivo para "application-local.properties" (ja ignorado no .gitignore)
# e sobrescreva as credenciais reais do seu ambiente.
spring.datasource.username=SEU_USUARIO
spring.datasource.password=SUA_SENHA

# Defina uma senha propria para o admin inicial (opcional, mas recomendado).
# Se nao definir, usa o valor padrao de application.properties -- so serve
# para o primeiro login, e so e usada se o banco ainda nao tiver nenhum
# usuario.
# app.admin-inicial.email=admin@suaempresa.com
# app.admin-inicial.senha=uma-senha-forte-so-sua
